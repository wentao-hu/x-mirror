# Cloudflare Pages headers
# HTML always revalidates; versioned static assets are immutable.

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/posts/*/
  Cache-Control: public, max-age=0, must-revalidate

/posts/*/index.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cloudflare 每条规则只允许一个 *，这里用 :slug 占位符
/posts/:slug/assets/*
  Cache-Control: public, max-age=31536000, immutable

/api/*
  Cache-Control: no-store
